# ============================================================
#  VS Code 调试用环境变量模板
#  用法：复制成 <catkin_ws>/.vscode/ros.env
#        （launch.json 里每个配置都写了
#          "envFile": "${workspaceFolder}/.vscode/ros.env"）
# ============================================================
#
#  为什么不直接给现成的 ros.env：
#    里面的路径全是"某台机器"的（用户名、catkin_ws 位置、CUDA 库路径
#    都各不相同），照抄必然报 ImportError / 找不到 lib。
#
#  【推荐做法】不要手改这个文件：在 VS Code 里
#    终端 → 运行任务 →「重新生成 ros.env」
#  它会 source 本机 ROS + devel/setup.bash 后自动导出真实路径。
#
#  手工填的话，把下面所有 /home/<你的用户名>/catkin_ws 换成自己的路径。
#  两个关键项：
#    · PYTHONPATH   必须包含 <catkin_ws>/devel/lib/python3/dist-packages
#    · LD_LIBRARY_PATH 必须包含 <catkin_ws>/devel/lib，否则 C++ 扩展加载失败

ROS_DISTRO=noetic
ROS_VERSION=1
ROS_PYTHON_VERSION=3
ROS_MASTER_URI=http://localhost:11311
ROS_ROOT=/opt/ros/noetic/share/ros
ROS_ETC_DIR=/opt/ros/noetic/etc/ros
ROS_PACKAGE_PATH=/home/<你的用户名>/catkin_ws/src:/opt/ros/noetic/share
CMAKE_PREFIX_PATH=/home/<你的用户名>/catkin_ws/devel:/opt/ros/noetic
PYTHONPATH=/home/<你的用户名>/catkin_ws/devel/lib/python3/dist-packages:/opt/ros/noetic/lib/python3/dist-packages
LD_LIBRARY_PATH=/home/<你的用户名>/catkin_ws/devel/lib:/opt/ros/noetic/lib
PKG_CONFIG_PATH=/home/<你的用户名>/catkin_ws/devel/lib/pkgconfig:/opt/ros/noetic/lib/pkgconfig
# PATH 只保留通用项；用其它方式装过 CUDA / cudnn 的按本机实际情况补
PATH=/opt/ros/noetic/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=/home/<你的用户名>
USER=<你的用户名>

# 显存防碎片：把已释放的显存块合并起来复用。4GB 卡上把 ReID / 姿态挪到 GPU 时
# 能显著降低 OOM 概率（torch 官方推荐，不改变精度）。
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
