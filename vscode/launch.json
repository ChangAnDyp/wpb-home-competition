    //   先手动执行一次 Tasks →「启动 Ollama（动作识别模型服务）」。
    // 【显式打开 TTS】start_voice 是总闸、start_tts 管播报、start_asr 管识别，
    //   后两个只有在 start_voice=true 时才有意义；而且 bringup 里 start_asr
    //   默认是 false、start_tts 默认 true。实测踩过一次"栈起来了但 TTS 没起"
    //   （rosnode list 里只有 /offline_asr_node、没有 /offline_tts_node，
    //   任务节点于是报 "No TTS subscriber connected on /voice/say"，全程哑巴）。
    //   所以这里把 start_tts 显式写出来，别依赖默认值。
    // map 指向新包里的比赛地图（wpb_service_robot/maps/map.yaml，
    // 就是那台真机/真实场地那份 PGM，不是厂商教程里的图）。
    // ⚠️ 光有地图还不够：导航前必须把机器人"现在在哪"告诉 AMCL，否则
    //    move_base 一定规划不出来（日志里会一直导航超时/ABORTED）。
    //    做法：起栈后 RViz 里用 "2D Pose Estimate" 点机器人实际位置 + 朝向，
    //    然后 rostopic echo -n1 /amcl_pose 确认坐标和实际位置对得上。
    {
      "name": "⑦【起栈】ROS: 启动机器人栈（含 TTS+ASR）",
      "type": "ros",
      "request": "launch",
      "target": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/launch/task1_owner_search_bringup.launch",
      "arguments": [
        "start_rviz:=false",
        "start_asr:=true",
        "start_tts:=true",
        "map:=/home/dyp/catkin_ws/src/wpb_service_robot/maps/map.yaml"
      ]
    },

    // ---------- ⑦b 起栈（注册专用：长语音窗口）----------
    // 和 ⑦ 完全一样，只把 ASR 的采集窗口从 2 秒改回 4 秒。
    // 原因：栈默认 asr_window_seconds:=2.0 是为了让现场问答反应快，
    // 但报名字时一句话（"姓名张三"）很容易被 2 秒窗口切成
    // "姓名张" / "姓名" / "装3" 这样的碎片，导致名字识别错。
    // 做注册（③b / ③c）时用这个起栈；平时跑任务用 ⑦。
    // ⚠️ 注意：能量阈值是在"软件增益放大之后"的信号上判断的，
    // 所以 gain 和 energy_threshold 是一对耦合参数，不能只改一个。
    // 实测教训：把 gain 2.0→1.0 同时 threshold 80→200，等于把灵敏度
    // 要求提高约 5 倍，结果什么声音都进不来（连续报"等待姓名超时"）。
    // 这里保持与 ⑦ 一致的采集参数，只改窗口长度这一个变量。
    {
      "name": "⑦b【起栈】注册专用（ASR 窗口 2.5 秒 + 语速 0.85）",
      "type": "ros",
      "request": "launch", 
      "target": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/launch/task1_owner_search_bringup.launch",
      "arguments": [
        "start_rviz:=false",
        "start_asr:=true",
        "start_tts:=true",
        "asr_window_seconds:=2.5",
        "start_yolo:=false",
        "tts_length_scale:=0.85",
        "map:=/home/dyp/catkin_ws/src/wpb_service_robot/maps/map.yaml"
      ]
    },

    // ---------- ⑧ 附加到运行中的节点 ----------
    // 节点已在终端里跑着时，用它挂上调试器看变量
    {
      "name": "⑧ ROS: 附加到运行中的节点",
      "type": "ros",
      "request": "attach"
    },

    // ---------- ⑨ 反馈节点（识别之后"说什么"）----------
    // 需要先起栈（⑦），并且要有动作识别结果在发布，否则收不到东西。
    // 收到 /pose_action_recognition/result 就按「主人{姓名}正在{动作}」播报。
    // 需要时的参数（加到下面 args 里）：
    //   _owner_name:=张三                 主人姓名（脸部注册做完后由主任务传，这里留空）
    //   _speak_enabled:=false             只打印不播报
    //   _voice_feedback_enabled:=false    关掉语音输入分支
    {
      "name": "⑨ 调试反馈节点 feedback_after_recognition（需先起栈+⑩）",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts/feedback_after_recognition.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_task1_owner_search",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ---------- ⑩ 动作识别（静音版，专供配合⑨测试）----------
    // 和 ② 完全一样，只多一个 _speak_enabled:=false。
    // 原因：② 自己也会播报识别结果，两个一起跑会把同一句话念两遍。
    // 测试反馈模块时用这个，让"说话"这件事只由反馈节点负责。
    {
      "name": "⑩ 调试动作识别（静音版，配合⑨）",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts/qwen_action_recognition_node.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": [
        "_auto_repeat_seconds:=5",
        "_overlay_hold_seconds:=5.0",
        "_pose_device:=cuda:0",
        "_pose_half:=true",
        "_pointcloud_furniture_height_limit:=0.40",
        "_speak_enabled:=false"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ---------- ⑪ 接近主人（原地，不导航）----------
    // 直接复用主任务节点①里真实的"找人 → 居中 → 识别动作 → 接近"链路，
    // 只是关掉导航和现场注册，不需要 waypoints.xml。
    //   _navigate_enabled:=false      不导航，原地开始（不需要航点文件）
    //   _owner_enrollment_enabled:=false 跳过现场注册，用已存的主人照片
    //   _allow_unverified_owner:=true 不强制人脸核验，便利用"接近"本身的测试
    //   _task_waypoint_names:=approach_test 航点列表缩成 1 个，避免循环 4 次
    //   _approach_navigation_enabled:=false 接近时不走 move_base，直接用
    //     cmd_vel 朝主人开过去。原因：栈里加载的是厂商教程地图
    //     (wpb_home_tutorials/maps/map.yaml)，和实际房间不匹配，move_base
    //     规划必然失败（日志表现为 no global plan / large detour）。
    //     只对"坐/躺/摔倒"这条路径有效；挥手那条只能用 move_base。
    // ⚠️ 接近过程中机器人会真的向前移动，请留出空间并把手放在急停上。
    {
      "name": "⑪ 调试接近主人（原地，不导航）",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts/task1_find_owner_real.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_task1_owner_search",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": [
        "_navigate_enabled:=false",
        "_owner_enrollment_enabled:=false",
        "_allow_unverified_owner:=true",
        "_approach_navigation_enabled:=false",
        "_action_use_owner_roi:=true",
        "_owner_lock_enabled:=true",
        "_task_waypoint_names:=approach_test"
      ],
      "preLaunchTask": "加载比赛参数到参数服务器",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "compounds": [
    // 一键同时启动「静音动作识别 + 反馈节点」，直接看端到端效果
    {
      "name": "【组合】动作识别⑩(静音) + 反馈⑨",
      "configurations": [
        "⑩ 调试动作识别（静音版，配合⑨）",
        "⑨ 调试反馈节点 feedback_after_recognition（需先起栈+⑩）"
      ],
      "stopAll": true
    }
  ]
}
