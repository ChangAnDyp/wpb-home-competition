{
  "version": "0.2.0",
  "configurations": [
    // ================================================================
    //  ⓪ 调试前请先启动机器人栈（下面「任务」里有一键启动）。
    //     节点必须连上 ROS master 才能真正跑起来。
    // ================================================================

    // ---------- ① 主任务节点（最常用）----------
    // 先启动栈，再按 F5。preLaunchTask 会自动把比赛参数加载到参数服务器，
    // 等价于 launch 文件里的 <rosparam load>；master 没起来时它会先报错提醒你。
    // 【当前方案：现场注册】args 里的 _owner_enrollment_enabled:=true 让节点
    // 不再读 data/owner 里的照片，改成开跑时语音问名字 + 现场拍脸。
    // 需要栈带 ASR，所以请先用「①b」启动机器人栈，不要用「①」。
    // 想切回【读照片】模式：把 args 里的 _owner_enrollment_enabled:=true 删掉。
    {
      "name": "①【节点】调试任务节点 task1_find_owner_real（需先起栈）",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts/task1_find_owner_real.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_task1_owner_search",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": ["_navigate_enabled:=false", "_owner_enrollment_enabled:=true"],
      "preLaunchTask": "加载比赛参数到参数服务器",
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ---------- ② 动作识别核心（可独立运行）----------
    // 订阅相机后按空格触发一次识别，用来单独验证“坐/躺/挥手/摔倒”判定。
    // _auto_repeat_seconds:=5  上一轮识别结束后隔 5 秒自动再识别（设 0 关掉，只按空格触发）
    // _overlay_hold_seconds:=5 识别完成后把带框/关键点/结论的画面保持 5 秒
    // _pose_device:=cuda:0     姿态模型跑 GPU（不可用时自动回退 CPU 并告警）
    // _pose_half:=true         GPU 上使用 FP16 推理
    {
      "name": "② 调试动作识别 qwen_action_recognition_node",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts/qwen_action_recognition_node.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": [
        "_auto_repeat_seconds:=5",
        "_overlay_hold_seconds:=5.0",
        "_pose_device:=cuda:0",
        "_pose_half:=true",
        "_pointcloud_furniture_height_limit:=0.40"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ---------- ③ 主人注册 ----------
    // 注意：这个脚本靠「语音问答」问名字，必须先跑 ① 把语音栈
    // （offline_tts_node + ASR）启动起来。栈没起时它会停在
    // "No TTS subscriber connected on /voice/say" 不动，不是死机。
    // 参数说明：
    //   _owner_count:=1        只注册 1 位主人（现在的陪练只有你一个人）。
    //                          想恢复"注册 3 位"，把这行删掉即可；那样在第
    //                          二/三位提问时说「跳过」也能跳过（第一位不能跳）。
    //   _navigate_enabled:=false 注册完直接原地进入识别循环，不做导航。
    {
      "name": "③ 调试主人注册 owner_voice_reid_test",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts/owner_voice_reid_test.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_task1_owner_search",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": ["_owner_count:=1", "_navigate_enabled:=false", "_reuse_existing_profile:=false"],
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ---------- ③b 主人注册（2 人）----------
    // 和 ③ 完全一样，只把 _owner_count 改成 2：依次注册两位主人，
    // 各自报名字（机器人会复述让你确认，务必核对）+ 站到镜头前采脸，
    // 完成后写入 data/reid_owner/owner_profile_1 与 _2（会覆盖同名文件），
    // 然后原地进入识别循环：两人轮流站到镜头前，看播报的名字对不对。
    // 前提：机器人栈必须带 ASR（用 ⑦【起栈】，它带 start_asr:=true）。
    {
      "name": "③b 调试主人注册（2人）owner_voice_reid_test",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts/owner_voice_reid_test.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_task1_owner_search",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": ["_owner_count:=2", "_navigate_enabled:=false", "_reuse_existing_profile:=false"],
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ---------- ③c 人脸 / 身形分步注册（2人）----------
    // 与 ③b 的区别：姓名加"确认"环节，并且把人脸和身形分成两步采集。
    //   第1步 问姓名 → 第2步 复述并确认（说"确认"或"重来"）
    //   第3步 只采人脸 → 第4步 只采身形 → 存成一份带姓名的档案
    // 注册完自动进入识别循环：识别眼前是谁并播报姓名。
    // 前提：机器人栈必须带 ASR（用 ⑦【起栈】）。
    {
      "name": "③c 调试人脸/身形分步注册（2人）face_body_enroll_test",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts/face_body_enroll_test.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_task1_owner_search",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": ["_owner_count:=2", "_navigate_enabled:=false", "_reuse_existing_profile:=false"],
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ---------- ③d 全流程：注册 → 寻找 → 识别 → 动作 ----------
    // 一条龙跑完：
    //   1) 注册 2 位主人（第 2 位可说"跳过"）
    //   2) 播报"开始寻找主人。"并原地旋转寻找
    //   3) 找到后播报"找到主人XXX了，现在开始检测您的动作。"
    //      然后只分析主人 ROI、只检测一次动作，播报动作后结束
    // 前提：机器人栈必须带 ASR（用 ⑦ 或 ⑦b【起栈】）。
    {
      "name": "③d 调试全流程 注册+寻找+动作 enroll_search_action_test",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts/enroll_search_action_test.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_task1_owner_search",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": [
        "_owner_count:=3",
        "_reuse_existing_profile:=false",
        "_action_pointcloud_enabled:=true",
        "_action_use_owner_roi:=false",
        "_tts_chars_per_second:=7.0"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ---------- ③e 只测"找人"（跳过注册，复用已有档案）----------
    // 每次跑 ③d 都要先注册两个人（约 2 分钟），调试找人逻辑时太慢。
    // 这个配置直接读 data/reid_owner/owner_profile_1、_2 两份已存档案
    // （张三 / 李4），跳过注册，直接进入"寻找主人"环节。
    // 改完找人逻辑用它验证，速度快得多。
    {
      "name": "③e 只测找人（跳过注册）enroll_search_action_test",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts/enroll_search_action_test.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_task1_owner_search",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": [
        "_owner_count:=2",
        "_reuse_existing_profile:=true",
        "_action_pointcloud_enabled:=true",
        "_action_use_owner_roi:=false",
        "_tts_chars_per_second:=7.0"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ---------- ③f 总任务：三人注册 + 逐位认人 + 报动作 ----------
    // task_all_owners.py 是"总任务"编排层：注册 3 位主人 → 对每一位
    // 单独旋转寻找（只认这一位）→ 居中 → 报姓名 → 调动作识别节点报动作。
    // 与 ③d 的区别：③d 找到第一位就结束，③f 会把三位都找一遍。
    // 注意它会注册 3 个人（约 3 分钟），只想测找人环节用 ③g。
    {
      "name": "③f 总任务 三人注册+逐位认人+动作 task_all_owners",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts/task_all_owners.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_task1_owner_search",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": [
        "_owner_count:=3",
        "_reuse_existing_profile:=false",
        "_action_pointcloud_enabled:=true",
        "_action_use_owner_roi:=false",
        "_tts_chars_per_second:=7.0"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ---------- ③g 总任务·只测找人（跳过注册）----------
    // 直接读 data/reid_owner/owner_profile_1、_2 两份已有档案，跳过注册。
    // 改完"逐位寻找"逻辑用它验证最快。以后补注册第 3 位，
    // 把 _owner_count 改成 3 即可。
    {
      "name": "③g 总任务·只测找人（跳过注册）task_all_owners",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_task1_owner_search/scripts/task_all_owners.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_task1_owner_search",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": [
        "_owner_count:=2",
        "_reuse_existing_profile:=true",
        "_action_pointcloud_enabled:=true",
        "_action_use_owner_roi:=false",
        "_tts_chars_per_second:=7.0"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ============================================================
    //  新包 wpb_service_robot：总任务（注册 + 找人 + 识别动作）
    //  与 ③f/③g 的区别：代码在新包里，路径/权重完全自洽，不再依赖
    //  wpb_task1_owner_search。未完成的功能（导航/机械臂/电器开关/回出口）
    //  以"预留接口"形式留在 scripts/task_all_owners.py 里。
    //  前提：机器人栈要带 ASR（用 ⑦ 或 ⑦b【起栈】）。
    // ============================================================

    // ---------- ⑫ 新包·总任务（三人注册 + 逐位认人 + 动作）----------
    // 导航已接上：注册完会依次导航去 living_room→kitchen→bedroom→canteen 找人。
    // 每间房只转【一圈】：转到谁就当场居中/报姓名/测动作，处理完接着转，
    // 所以同一间屋里站着两位主人也能在这一圈里都认出来（不用再转第二圈）。
    // 三位都找到就提前收尾（剩下的房间不去），最后导航去 exit。
    // 播报之后的实际反应：主人【挥手】时，机器人会走近他 →
    // 问"请问您需要什么帮助？"→ 听主人说 → 复述"您需要的是：<原话>。"
    // （规则 2.6-5 的判据就是"能够将主人的帮助需求以原意复述"，
    //   所以旧实现"只问不听不复述"拿不到这 50 分；听不清会自动重问一轮。）
    // 走近：用点云量真实距离，停到离主人 1.0 米（_approach_standoff_distance）；
    // 点云不占显存（纯 CPU 搬运，实测 0.5ms/帧），看不到人就立刻停，不会盲开。
    // 不想让它走 → _approach_enabled:=false；不想让它问 → _ask_help_enabled:=false。
    // 主人【坐着/躺着】时，会问"需要我帮您操作电器开关吗？要打开还是关闭？"，
    // 听懂后播报"电器开关已经打开了/关掉了"。
    // ⚠️ 开关这一段**只播报，不动机械臂**：开关标记的视觉检测硬件暂时不支持，
    //    所以主任务一条机械臂指令都不发（等硬件到位再补 operate_switch 里那半）。
    //    不想让它问 → _ask_switch_enabled:=false。
    // 【垃圾】已放弃（找垃圾要跑 YOLO-World，实测 CPU 占用太高，设备撑不住），
    //    留了开关但不启用：_trash_announce_enabled:=false 显式关掉，
    //    免得残留参数把它打开。代码还在 task_all_owners.py 里，没删。
    // 时间预算按"注册也算在 8 分钟里"来算：注册约 2 分钟，剩约 6 分钟；
    // 剩余时间不够『走一趟 + 转一圈』的房间直接不去，保证走得回出口。
    // ⚠️ 机器人会真的走，请留出空间、手放急停；跑之前先确认定位好了：
    //     rostopic echo -n1 /amcl_pose     能看到和实际位置一致的坐标
    // 想不导航、原地转圈找（调试识别算法）→ 把 _navigate_enabled 改成 false。
    // 想换房间顺序 / 少去几个房间 → 改 _search_waypoints。
    {
      "name": "⑫ 新包·总任务 三人注册+认人+动作 task_all_owners",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_service_robot/scripts/task_all_owners.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_service_robot",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": [
        "_owner_count:=3",
        "_reuse_existing_profile:=false",
        "_navigate_enabled:=true",
        "_waypoint_file:=/home/dyp/waypoints.xml",
        "_search_waypoints:=living_room,kitchen,bedroom,canteen",
        "_exit_waypoint_name:=exit",
        "_trash_announce_enabled:=false",
        "_action_pointcloud_enabled:=true",
        "_action_use_owner_roi:=false",
        "_tts_chars_per_second:=7.0"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ---------- ⑬ 新包·只测找人（跳过注册，复用已有档案）----------
    // 和 ⑫ 完全一样，只是跳过注册、直接用已有档案 —— 专门验证"逐房间导航 + 找人"。
    // 同样会真的走，且同样显式写了 _navigate_enabled / _search_waypoints：
    // 这两个参数如果哪次运行传过、残留在 ROS master 上，不写清楚就会被上次的值影响
    // （踩过的坑：跑完 ③g 紧接着跑 ③f，③f 莫名其妙跳过了注册）。
    {
      "name": "⑬ 新包·只测找人（跳过注册）task_all_owners",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_service_robot/scripts/task_all_owners.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_service_robot",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": [
        "_owner_count:=2",
        "_reuse_existing_profile:=true",
        "_navigate_enabled:=true",
        "_waypoint_file:=/home/dyp/waypoints.xml",
        "_search_waypoints:=living_room,kitchen,bedroom,canteen",
        "_exit_waypoint_name:=exit",
        "_trash_announce_enabled:=false",
        "_action_pointcloud_enabled:=true",
        "_action_use_owner_roi:=false",
        "_tts_chars_per_second:=7.0"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },


    // ---------- ⑭ 新包·原地测找人（空跑：不移动）----------
    // 用途：不想让车真的开去客厅，只想在**当前位置**把"到达客厅之后那一套"
    //   测完（正在前往客厅 → 转一圈找人 → 居中 → 报姓名 → 测动作 → 反应 → 收尾）。
    //   _navigate_dry_run:=true 让导航一步都不走，日志里会打
    //   「空跑模式：不移动，直接当作已到达 living_room（客厅）」。
    //   _search_waypoints 只留 living_room：只跑客厅这一间，测一轮约 1 分钟。
    //   连"回出口"也不会动（同样被空跑挡住）。
    //   想连"正在前往客厅寻找主人"那句都不说 → 加 _search_go_text:=
    {
      "name": "⑭ 新包·原地测找人（空跑不移动）task_all_owners",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
      "program": "/home/dyp/catkin_ws/src/wpb_service_robot/scripts/task_all_owners.py",
      "cwd": "/home/dyp/catkin_ws/src/wpb_service_robot",
      "envFile": "${workspaceFolder}/.vscode/ros.env",
      "args": [
        "_owner_count:=2",
        "_reuse_existing_profile:=true",
        "_navigate_enabled:=true",
        "_navigate_dry_run:=true",
        "_waypoint_file:=/home/dyp/waypoints.xml",
        "_search_waypoints:=living_room",
        "_exit_waypoint_name:=exit",
        "_trash_announce_enabled:=false",
        "_action_pointcloud_enabled:=true",
        "_action_use_owner_roi:=false",
        "_tts_chars_per_second:=7.0"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ---------- ⑭b 原地测找人·GPU 版（ReID + 姿态上显卡，A/B 对照用）----------
    // 和 ⑭ 完全一样，只多了两个设备参数：
    //   _reid_device:=cuda:0       主人 ReID（OSNet x0_25）从 CPU → GPU
    //   _action_pose_device:=cuda:0 动作识别（YOLO11n-pose）从 CPU → GPU
    //   _face_ctx_id:=0            人脸 InsightFace（检测 det_500m + 识别 w600k_mbf）→ GPU
    // 人脸这块的坑（已解决）：onnxruntime 的 providers=None **不是"自动选最快的"**，
    //   而是"不指定 EP"= 只用 CPU；且原装 onnxruntime 是 CPU 版。2026-10-09 已换成
    //   onnxruntime-gpu 1.17.1（CUDA12 构建，匹配 torch 自带的 cuDNN 8），并在
    //   owner_voice_reid_test.init_face_recognizer 里显式传
    //   [('CUDAExecutionProvider',{'device_id':ctx_id}), 'CPUExecutionProvider']
    //   （CUDA 加载失败会自动降级 CPU，不会让注册流程挂掉）。
    // 显存预算（GTX 1650 4096MiB，基线 12MiB）— 全部是实测值：
    //   ReID（OSNet，在任务进程）        ≈ 316 MiB
    //   人脸（det+rec，同一任务进程）    ≈ 270 MiB
    //   姿态（YOLO11n-pose，动作节点）   ≈ 180 MiB
    //   合计 ≈ 0.77GB → 约占 19%，余量 >3GB（红线：超过 2.5GB 就回退）
    // 风险与回退：显存不够时 ReID 加载会报错、动作节点会退化成 unknown；
    //   把这三行参数删掉就回到 ⑭ 的纯 CPU 行为（节点自身也有 CUDA 不可用自动回退）。
    //   跑的时候用 tools/resource_report.sh 看 nvidia-smi，超过 ~2.5GB 就该收手。
    {
      "name": "⑭b 原地测找人·GPU版（ReID+人脸+姿态上显卡）task_all_owners",
      "type": "python",
      "request": "launch",
      "python": "/usr/bin/python3",
