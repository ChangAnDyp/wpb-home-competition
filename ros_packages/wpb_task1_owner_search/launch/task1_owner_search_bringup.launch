<launch>
  <arg name="show_yolo_viewer" default="false" />
  <!-- 启动 YOLO-World 行人检测节点。③d 那条流程改用姿态模型做人体检测
       （YOLO-World 对躺姿几乎检不出来），可以传 start_yolo:=false 把它
       停掉，省一个 GPU 进程。原来这里写死 true 且未声明，命令行传参会被
       静默忽略 —— 必须声明出来才生效。 -->
  <arg name="start_yolo" default="true" />
  <arg name="yolo_output" default="log" />
  <arg name="yolo_respawn" default="true" />
  <arg name="yolo_respawn_delay" default="2.0" />
  <arg name="viewer_respawn" default="true" />
  <arg name="start_rviz" default="true" />
  <arg name="start_voice" default="true" />
  <arg name="start_asr" default="false" />
  <arg name="start_tts" default="true" />
  <arg name="start_sound_play" default="true" />
  <arg name="asr_capture_device" default="default" />
  <arg name="asr_capture_backend" default="pulse" />
  <arg name="asr_capture_source" default="" />
  <arg name="asr_capture_volume" default="150%" />
  <arg name="asr_capture_gain" default="2.0" />
  <arg name="asr_energy_threshold" default="80" />
  <arg name="asr_window_seconds" default="2.0" />
  <!-- 声学级静音：TTS 播报期间 ASR 暂停录音。
       排查"完全听不到语音"时可传 asr_tts_squelch:=false 关闭。 -->
  <arg name="asr_tts_squelch" default="true" />
  <!-- TTS 语速（Piper length_scale，越小越快，1.0 = 原速） -->
  <arg name="tts_length_scale" default="1.0" />
  <arg name="map" default="$(find wpb_home_tutorials)/maps/map.yaml" />
  <arg name="waypoint_file" default="/home/$(env USER)/waypoints.xml" />
  <arg name="device" default="cuda:0" />

  <!-- 现场注册相关（原文件未声明，导致命令行无法覆盖） -->
  <arg name="owner_enrollment_enabled" default="false" />
  <arg name="owner_enrollment_capture_seconds" default="5.0" />
  <arg name="owner_enrollment_min_samples" default="6" />

  <!--
    下面这些参数原上游没有在这里声明，导致命令行传
    "use_jie_lidar_loc:=false" 之类会被静默忽略、仍然按默认值启动。
    这里补齐声明并转发给 task1_owner_search_real.launch。
  -->
  <arg name="start_base" default="true" />
  <arg name="start_lidar" default="true" />
  <arg name="start_kinect" default="true" />
  <arg name="start_map_server" default="true" />
  <arg name="start_amcl" default="true" />
  <arg name="use_jie_lidar_loc" default="false" />
  <arg name="start_move_base" default="true" />
  <arg name="start_wp_manager" default="true" />
  <arg name="serial_port" default="/dev/ftdi" />
  <arg name="rplidar_port" default="/dev/rplidar" />

  <param name="/asr/capture_device" value="$(arg asr_capture_device)" />
  <param name="/asr/energy_threshold" value="$(arg asr_energy_threshold)" />

  <include file="$(find wpb_task1_owner_search)/launch/task1_owner_search_real.launch">
    <arg name="start_robot" value="true" />
    <arg name="start_yolo" value="$(arg start_yolo)" />
    <arg name="show_yolo_viewer" value="$(arg show_yolo_viewer)" />
    <arg name="yolo_output" value="$(arg yolo_output)" />
    <arg name="yolo_respawn" value="$(arg yolo_respawn)" />
    <arg name="yolo_respawn_delay" value="$(arg yolo_respawn_delay)" />
    <arg name="viewer_respawn" value="$(arg viewer_respawn)" />
    <arg name="start_voice" value="$(arg start_voice)" />
    <arg name="start_asr" value="$(arg start_asr)" />
    <arg name="start_tts" value="$(arg start_tts)" />
    <arg name="start_sound_play" value="$(arg start_sound_play)" />
    <arg name="asr_capture_device" value="$(arg asr_capture_device)" />
    <arg name="asr_capture_backend" value="$(arg asr_capture_backend)" />
    <arg name="asr_capture_source" value="$(arg asr_capture_source)" />
    <arg name="asr_capture_volume" value="$(arg asr_capture_volume)" />
    <arg name="asr_capture_gain" value="$(arg asr_capture_gain)" />
    <arg name="asr_energy_threshold" value="$(arg asr_energy_threshold)" />
    <arg name="asr_window_seconds" value="$(arg asr_window_seconds)" />
    <arg name="asr_tts_squelch" value="$(arg asr_tts_squelch)" />
    <arg name="tts_length_scale" value="$(arg tts_length_scale)" />
    <arg name="start_task" value="false" />
    <arg name="start_rviz" value="$(arg start_rviz)" />
    <arg name="map" value="$(arg map)" />
    <arg name="waypoint_file" value="$(arg waypoint_file)" />
    <arg name="device" value="$(arg device)" />
    <arg name="owner_enrollment_enabled" value="$(arg owner_enrollment_enabled)" />
    <arg name="owner_enrollment_capture_seconds" value="$(arg owner_enrollment_capture_seconds)" />
    <arg name="owner_enrollment_min_samples" value="$(arg owner_enrollment_min_samples)" />
    <arg name="start_base" value="$(arg start_base)" />
    <arg name="start_lidar" value="$(arg start_lidar)" />
    <arg name="start_kinect" value="$(arg start_kinect)" />
    <arg name="start_map_server" value="$(arg start_map_server)" />
    <arg name="start_amcl" value="$(arg start_amcl)" />
    <arg name="use_jie_lidar_loc" value="$(arg use_jie_lidar_loc)" />
    <arg name="start_move_base" value="$(arg start_move_base)" />
    <arg name="start_wp_manager" value="$(arg start_wp_manager)" />
    <arg name="serial_port" value="$(arg serial_port)" />
    <arg name="rplidar_port" value="$(arg rplidar_port)" />
  </include>
</launch>
